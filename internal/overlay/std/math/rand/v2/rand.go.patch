+// runtimeSource gives the source that the top-level functions read. Go reads
+// the generator of its runtime, and the operating system seeds that generator.
+// The seed here comes from the clock, thus the values stay unpredictable and no
+// program can depend on them.
+func runtimeSource() Source {
+	var seed [32]byte
+	x := uint64(dart.NowNanos())
+	for i := range seed {
+		x = x*6364136223846793005 + 1442695040888963407
+		seed[i] = byte(x >> 56)
+	}
+	return NewChaCha8(seed)
