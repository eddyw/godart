 // Instead, they are replaced by the Unicode replacement
 // character U+FFFD.
 func Unmarshal(data []byte, v any) error {
+	switch code, a, b := dart.JSONUnmarshal(data, v); code {
+	case jsonFastDone:
+		return nil
+	case jsonFastMethod:
+		return callUnmarshalJSON(v.(Unmarshaler), data[a:b])
+	case jsonFastMaxDepth:
+		// jsontext reports the offset of the bracket, and the legacy rule of
+		// v1 adds 1 byte to the offset of a structural error.
+		return &SyntaxError{msg: "exceeded max depth", Offset: int64(a) + 1}
+	}
 	return jsonv2.Unmarshal(data, v, DefaultOptionsV1())
+}
+
+// callUnmarshalJSON gives the bytes of the value to the method of the target.
+//
+// The v1 options hold ReportErrorsWithLegacySemantics, thus the caller reads
+// the error of the method with no wrapper. errors.ErrUnsupported is the 1
+// answer that the package replaces.
+func callUnmarshalJSON(u Unmarshaler, val []byte) error {
+	err := u.UnmarshalJSON(val)
+	if errors.Is(err, errors.ErrUnsupported) {
+		return errors.New("UnmarshalJSON method may not return errors.ErrUnsupported")
+	}
+	return err
 }
 
