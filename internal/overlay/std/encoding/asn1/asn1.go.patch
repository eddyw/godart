+
+// chunkSize is the limit of the memory that the parse takes with no check.
+// internal/saferio holds the same value.
+const chunkSize = 10 << 20
+
+// sliceCapWithSize gives the cap for a slice of c values of the named size. A
+// negative result names a count that is always too big. The body comes from
+// saferio.SliceCapWithSize.
+func sliceCapWithSize(size, c uint64) int {
+	if int64(c) < 0 || c != uint64(int(c)) {
+		return -1
+	}
+	if size > 0 && c > (1<<64-1)/size {
+		return -1
+	}
+	if c*size > chunkSize {
+		c = chunkSize / size
+		if c == 0 {
+			c = 1
+		}
+	}
+	return int(c)
+}
