This patch adapts Go 1.27.1 src/encoding/asn1/asn1.go under the retained
Go BSD license. The original source header remains in the patched output.

Recursive fields yield after 64 levels without a change to the depth limit.
The existing saferio slice-cap adaptation remains unchanged.

--- asn1.go
+++ asn1.go
@@ -22,7 +22,6 @@
 import (
 	"errors"
 	"fmt"
-	"internal/saferio"
 	"math"
 	"math/big"
 	"reflect"
@@ -669,7 +668,7 @@
 		numElements++
 	}
 	elemSize := uint64(elemType.Size())
-	safeCap := saferio.SliceCapWithSize(elemSize, uint64(numElements))
+	safeCap := sliceCapWithSize(elemSize, uint64(numElements))
 	if safeCap < 0 {
 		err = SyntaxError{fmt.Sprintf("%s slice too big: %d elements of %d bytes", elemType.Kind(), numElements, elemSize)}
 		return
@@ -708,6 +707,10 @@
 // into the array, it will try to parse a suitable ASN.1 value out and store it
 // in the given Value.
 func parseField(v reflect.Value, bytes []byte, initOffset int, params fieldParameters, depth int) (offset int, err error) {
+	// Release the fixed Dart stack before another 64 recursive levels.
+	if depth%64 == 0 {
+		runtime.Gosched()
+	}
 	depth++
 	const (
 		maxDecodeDepth     = 10000
@@ -1180,3 +1183,26 @@
 	}
 	return b[offset:], nil
 }
+
+// chunkSize is the limit of the memory that the parse takes with no check.
+// internal/saferio holds the same value.
+const chunkSize = 10 << 20
+
+// sliceCapWithSize gives the cap for a slice of c values of the named size. A
+// negative result names a count that is always too big. The body comes from
+// saferio.SliceCapWithSize.
+func sliceCapWithSize(size, c uint64) int {
+	if int64(c) < 0 || c != uint64(int(c)) {
+		return -1
+	}
+	if size > 0 && c > (1<<64-1)/size {
+		return -1
+	}
+	if c*size > chunkSize {
+		c = chunkSize / size
+		if c == 0 {
+			c = 1
+		}
+	}
+	return int(c)
+}
