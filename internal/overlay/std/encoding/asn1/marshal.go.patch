 func (t *taggedEncoder) Len() int {
-	return t.tag.Len() + t.body.Len()
+	return t.length
 }
 
 func (t *taggedEncoder) Encode(dst []byte) {
-	t.tag.Encode(dst)
-	t.body.Encode(dst[t.tag.Len():])
+	pending := []encoder{t}
+	for len(pending) > 0 {
+		e := pending[len(pending)-1]
+		pending = pending[:len(pending)-1]
+		switch e := e.(type) {
+		case *taggedEncoder:
+			e.tag.Encode(dst)
+			dst = dst[e.tag.Len():]
+			pending = append(pending, e.body)
+		case multiEncoder:
+			for i := len(e) - 1; i >= 0; i-- {
+				pending = append(pending, e[i])
+			}
+		default:
+			e.Encode(dst)
+			dst = dst[e.Len():]
+		}
+	}
 }
 
