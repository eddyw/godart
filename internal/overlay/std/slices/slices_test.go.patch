The patch omits TestIssue68488. It reads native addresses through
unsafe.SliceData and tests the liveness rules of the Go garbage collector.
Dart controls object storage and garbage collection.

The remaining assertions retain their upstream bodies.

--- slices_test.go
+++ slices_test.go
@@ -14,5 +14,4 @@
 	. "slices"
 	"strings"
 	"testing"
-	"unsafe"
 )
@@ -1456,14 +1456,2 @@
 
-var leak *int
-
-func TestIssue68488(t *testing.T) {
-	s := make([]int, 3)
-	clone := Clone(s[1:1])
-	switch unsafe.SliceData(clone) {
-	case &s[0], &s[1], &s[2]:
-		t.Error("clone keeps alive s due to array overlap")
-	}
-	leak = &s[1] // see go.dev/issue/74387
-}
-
 // This test asserts the behavior when the primary slice operand is nil.
