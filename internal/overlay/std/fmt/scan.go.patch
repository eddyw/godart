-	if err == nil {
-		s.count++
-		if s.nlIsEnd && r == '\n' {
+	// Preserve nested limits without recursive scanner wrapper calls.
+	var parents []*ss
+	for {
+		if s.atEOF || s.count >= s.argLimit {
+			err = io.EOF
+			break
+		}
+		parents = append(parents, s)
+		if parent, ok := s.rs.(*ss); ok {
+			s = parent
+			continue
+		}
+		r, size, err = s.rs.ReadRune()
+		break
+	}
+	for i := len(parents) - 1; i >= 0; i-- {
+		s = parents[i]
+		if err == nil {
+			s.count++
+			if s.nlIsEnd && r == '\n' {
+				s.atEOF = true
+			}
+		} else if err == io.EOF {
 			s.atEOF = true
 		}
-	} else if err == io.EOF {
-		s.atEOF = true
 	}
 	return
 }
