Preserve browser fetch with the original Go HTTP transport.
The source retains the original Go BSD header.

--- roundtrip.go
+++ roundtrip.go
@@ -7,6 +7,16 @@
 package http
 
 import _ "unsafe" // for linkname
+import "runtime"
+import (
+	"context"
+	"errors"
+	"io"
+	"net/url"
+	"strconv"
+	"strings"
+	"syscall/dart"
+)
 
 // RoundTrip should be an internal detail,
 // but widely used packages access it using linkname.
@@ -30,5 +40,215 @@
 	if t == nil {
 		panic("transport is nil")
 	}
+	if runtime.GOOS == "js" && t.Dial == nil && t.DialContext == nil &&
+		t.DialTLS == nil && t.DialTLSContext == nil {
+		return t.fetchRoundTrip(req)
+	}
 	return t.roundTrip(req)
 }
+
+
+// errFetchClosed is the cause that a read of a closed body gives.
+var errFetchClosed = errors.New("net/http: reader is closed")
+
+// fetchRoundTrip sends 1 request through the fetch API of the host.
+//
+// A browser holds no socket, thus the web target reaches the network through
+// this path. The host follows a redirect on its own, thus CheckRedirect of a
+// Client never runs there, and the host also decodes the gzip form. Go gives
+// the same 2 answers under GOOS=js.
+func (t *Transport) fetchRoundTrip(req *Request) (*Response, error) {
+	if req.URL == nil {
+		req.closeBody()
+		return nil, errors.New("http: nil Request.URL")
+	}
+	if req.Header == nil {
+		req.closeBody()
+		return nil, errors.New("http: nil Request.Header")
+	}
+	scheme := req.URL.Scheme
+	isHTTP := scheme == "http" || scheme == "https"
+	if isHTTP {
+		if err := validateHeaders(req.Header); err != "" {
+			req.closeBody()
+			return nil, errors.New("net/http: invalid header " + err)
+		}
+		if err := validateHeaders(req.Trailer); err != "" {
+			req.closeBody()
+			return nil, errors.New("net/http: invalid trailer " + err)
+		}
+	}
+	origReq := req
+	if altRT := t.alternateRoundTripper(req); altRT != nil {
+		req = setupRewindBody(req)
+		if resp, err := altRT.RoundTrip(req); err != ErrSkipAltProtocol {
+			return resp, err
+		}
+		var err error
+		req, err = rewindBody(req)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if !isHTTP {
+		req.closeBody()
+		return nil, badStringError("unsupported protocol scheme", scheme)
+	}
+	if req.Method != "" && !validMethod(req.Method) {
+		req.closeBody()
+		return nil, badStringError("net/http: invalid method", req.Method)
+	}
+	if req.URL.Host == "" {
+		req.closeBody()
+		return nil, errors.New("http: no Host in request URL")
+	}
+	select {
+	case <-req.Context().Done():
+		req.closeBody()
+		return nil, context.Cause(req.Context())
+	default:
+	}
+	ctx, cancel := context.WithCancelCause(req.Context())
+	if req.Cancel != nil {
+		go awaitLegacyCancel(ctx, cancel, req)
+	}
+	cancel = t.prepareTransportCancel(origReq, cancel)
+	var body []byte
+	if req.Body != nil {
+		read, err := io.ReadAll(req.Body)
+		req.Body.Close()
+		if cause := context.Cause(ctx); cause != nil {
+			cancel(cause)
+			return nil, cause
+		}
+		if err != nil {
+			cancel(err)
+			return nil, err
+		}
+		body = read
+	}
+	fields := make([]string, 0, 2*len(req.Header))
+	for name, values := range req.Header {
+		for _, value := range values {
+			fields = append(fields, name, value)
+		}
+	}
+	handle := dart.FetchOpen()
+	stopAbort := context.AfterFunc(ctx, func() { dart.FetchCancel(handle) })
+	stop := func() {
+		stopAbort()
+		cancel(errRequestDone)
+	}
+	method := req.Method
+	if method == "" {
+		method = MethodGet
+	}
+	code, status, head, moved, cause := dart.FetchStart(
+		handle, method, req.URL.String(), fields, body, fetchDeadline(req))
+	if cause != "" {
+		err := context.Cause(ctx)
+		stop()
+		dart.FetchClose(handle)
+		if err != nil {
+			return nil, err
+		}
+		return nil, errors.New("net/http: fetch() failed: " + cause)
+	}
+	header := Header{}
+	for i := 0; i+1 < len(head); i += 2 {
+		key := CanonicalHeaderKey(head[i])
+		header[key] = append(header[key], head[i+1])
+	}
+	length := int64(-1)
+	if text := header.Get("Content-Length"); text != "" {
+		n, err := strconv.ParseInt(text, 10, 64)
+		if err != nil || n < 0 {
+			stop()
+			dart.FetchClose(handle)
+			return nil, errors.New(
+				"net/http: invalid Content-Length header: " + strconv.Quote(text))
+		}
+		length = n
+	}
+	uncompressed := false
+	if strings.EqualFold(header.Get("Content-Encoding"), "gzip") {
+		header.Del("Content-Encoding")
+		header.Del("Content-Length")
+		length = -1
+		uncompressed = true
+	}
+	req = origReq
+	if moved != "" {
+		if target, err := url.Parse(moved); err == nil {
+			req = req.WithContext(req.Context())
+			req.URL = target
+		}
+	}
+	if status == "" {
+		status = StatusText(code)
+	}
+	return &Response{
+		Status:        strconv.Itoa(code) + " " + status,
+		StatusCode:    code,
+		Header:        header,
+		ContentLength: length,
+		Uncompressed:  uncompressed,
+		Body:          &fetchBody{handle: handle, ctx: ctx, stop: stop},
+		Request:       req,
+	}, nil
+}
+
+// fetchDeadline gives the end of the request, in nanoseconds after the start
+// of the Unix epoch. A value of 0 holds no limit.
+func fetchDeadline(req *Request) int64 {
+	if deadline, ok := req.Context().Deadline(); ok {
+		return deadline.UnixNano()
+	}
+	return 0
+}
+
+// fetchBody reads the body of an answer of the fetch API.
+type fetchBody struct {
+	ctx context.Context
+	stop func()
+	handle int
+	closed bool
+	eof bool
+}
+
+func (b *fetchBody) Read(p []byte) (int, error) {
+	if b.closed {
+		return 0, errFetchClosed
+	}
+	if b.eof {
+		return 0, io.EOF
+	}
+	if err := context.Cause(b.ctx); err != nil {
+		return 0, err
+	}
+	n, cause := dart.FetchRead(b.handle, p)
+	if err := context.Cause(b.ctx); err != nil {
+		return n, err
+	}
+	if cause != "" {
+		return n, errors.New(cause)
+	}
+	if n == 0 && len(p) > 0 {
+		b.eof = true
+		b.stop()
+		return 0, io.EOF
+	}
+	return n, nil
+}
+
+func (b *fetchBody) Close() error {
+	if b.closed {
+		return nil
+	}
+	b.closed = true
+	b.stop()
+	if cause := dart.FetchClose(b.handle); cause != "" {
+		return errors.New(cause)
+	}
+	return nil
+}
